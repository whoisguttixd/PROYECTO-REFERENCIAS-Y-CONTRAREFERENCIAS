@model PROYECTO_REFERENCIAS.Models.Especialidad
@{
    ViewData["Title"] = Model.IdEspecialidad > 0 ? "Editar Especialidad" : "Nueva Especialidad";
}

<a asp-controller="Especialidad" asp-action="Index" class="btn btn-outline-secondary mb-2">
    Volver
</a>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        @if (ViewData["Mensaje"] != null)
        {
            <div class="alert alert-warning">@ViewData["Mensaje"]</div>
        }

        <form asp-controller="Especialidad" asp-action="Crear" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Código CIE-10 / Interno <span class="text-danger">*</span></label>
                    <input class="form-control" asp-for="Codigo" placeholder="Ej: CIE-10-MEDINT" />
                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Nombre <span class="text-danger">*</span></label>
                    <input class="form-control" asp-for="Nombre" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Descripción</label>
                    <textarea class="form-control" asp-for="Descripcion" rows="3" placeholder="Descripción de la especialidad..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Nivel de Atención</label>
                    <select class="form-select" asp-for="NivelAtencion">
                        <option value="I">I - Atención Primaria</option>
                        <option value="II">II - Atención Especializada</option>
                        <option value="III">III - Alta Complejidad</option>
                        <option value="IV">IV - Especialidad de Alta Complejidad</option>
                    </select>
                    <span asp-validation-for="NivelAtencion" class="text-danger"></span>
                </div>

                <div class="col-12 d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Guardar Especialidad</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
