@model IEnumerable<PROYECTO_REFERENCIAS.Models.EstablecimientoSalud>
@{
    ViewData["Title"] = "Establecimientos de Salud";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@ViewData["Title"]</h3>
    <a asp-controller="EstablecimientoSalud" asp-action="Crear" class="btn btn-primary">
        Nuevo Establecimiento
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewData["Mensaje"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @ViewData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input class="form-control" type="search" name="filtro" value="@ViewBag.Filtro" placeholder="Código, nombre, tipo, red o distrito" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Filtro))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay establecimientos registrados.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Código</th>
                <th>Establecimiento</th>
                <th>Tipo</th>
                <th>Red de Salud</th>
                <th>Ubicación</th>
                <th>Especialidades</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td><span class="fw-semibold">@e.Codigo</span></td>
                    <td>
                        <div class="fw-medium">@e.Nombre</div>
                        <small class="text-muted">@e.RepresentanteLegal</small>
                    </td>
                    <td>@e.TipoEstablecimiento</td>
                    <td>@e.RedSalud</td>
                    <td>@e.Ubicacion</td>
                    <td>@e.EstablecimientoEspecialidades?.Count ?? 0</td>
                    <td>
                        <a asp-controller="EstablecimientoSalud" asp-action="AsignarEspecialidades" asp-route-id="@e.IdEstablecimiento" class="btn btn-sm btn-outline-primary">Especialidades</a>
                        <a asp-controller="EstablecimientoSalud" asp-action="Detalles" asp-route-id="@e.IdEstablecimiento" class="btn btn-sm btn-outline-secondary">Detalles</a>
                        <a asp-controller="EstablecimientoSalud" asp-action="Editar" asp-route-id="@e.IdEstablecimiento" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-controller="EstablecimientoSalud" asp-action="Eliminar" asp-route-id="@e.IdEstablecimiento" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar establecimiento @e.Nombre (Código @e.Codigo)?');">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
