@model PROYECTO_REFERENCIAS.Models.EstablecimientoSalud
@{
    ViewData["Title"] = Model.IdEstablecimiento > 0 ? "Editar Establecimiento" : "Nuevo Establecimiento";
}

<a asp-controller="EstablecimientoSalud" asp-action="Index" class="btn btn-outline-secondary mb-2">
    Volver
</a>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        @if (ViewData["Mensaje"] != null)
        {
            <div class="alert alert-warning">@ViewData["Mensaje"]</div>
        }

        <form asp-controller="EstablecimientoSalud" asp-action="Crear" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Código Interno <span class="text-danger">*</span></label>
                    <input class="form-control" asp-for="Codigo" placeholder="Ej: CS-CH01" />
                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Nombre <span class="text-danger">*</span></label>
                    <input class="form-control" asp-for="Nombre" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tipo de Establecimiento <span class="text-danger">*</span></label>
                    <select class="form-select" asp-for="TipoEstablecimiento">
                        <option value="">-- Seleccione --</option>
                        <option value="Hospital Regional">Hospital Regional</option>
                        <option value="Hospital Docente">Hospital Docente</option>
                        <option value="Hospital Distrital">Hospital Distrital</option>
                        <option value="Centro de Salud">Centro de Salud</option>
                        <option value="Posta Médica">Posta Médica</option>
                        <option value="Clinica Privada">Clínica Privada</option>
                    </select>
                    <span asp-validation-for="TipoEstablecimiento" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Red de Salud <span class="text-danger">*</span></label>
                    <select class="form-select" asp-for="RedSalud">
                        <option value="">-- Seleccione --</option>
                        <option value="Regional">Regional</option>
                        <option value="Chota">Chota</option>
                        <option value="Jaén">Jaén</option>
                        <option value="Celendín">Celendín</option>
                        <option value="Bambamarca">Bambamarca</option>
                        <option value="Cajabamba">Cajabamba</option>
                        <option value="Contumazá">Contumazá</option>
                        <option value="Cochabamba">Cochabamba</option>
                        <option value="Culpín">Culpín</option>
                        <option value="Encanatares">Encanatares</option>
                        <option value="Joras">Joras</option>
                        <option value="Lauricocha">Lauricocha</option>
                        <option value="Los Andes">Los Andes</option>
                        <option value="Mitma">Mitma</option>
                        <option value="Ninacaca">Ninacaca</option>
                    </select>
                    <span asp-validation-for="RedSalud" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Ubicación <span class="text-danger">*</span></label>
                    <input class="form-control" asp-for="Ubicacion" placeholder="Distrito/Provincia" />
                    <span asp-validation-for="Ubicacion" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" asp-for="Telefono" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Representante Legal</label>
                    <input class="form-control" asp-for="RepresentanteLegal" placeholder="Médico a Cargo / Director..." />
                    <span asp-validation-for="RepresentanteLegal" class="text-danger"></span>
                </div>

                <div class="col-12 d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Guardar Establecimiento</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
